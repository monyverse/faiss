{
  "name": "faiss-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:embed": "vite build --config vite.embed.config.ts",
    "start": "node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "verify:server": "node scripts/verify-server.mjs",
    "demo:embed": "node scripts/serve-embed-demo.mjs",
    "build:image": "bun run build:embed && cp dist-embed/faiss-copilot.js public/faiss-copilot.js && bun run build",
    "verify:streaming": "node scripts/verify-streaming.mjs",
    "check:ui": "node scripts/ui-check.mjs"
  },
  "overrides": {
    "rolldown": "1.2.1"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "clsx": "2.1.1",
    "lucide-react": "0.575.0",
    "oidc-client-ts": "3.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-plugin": "1.168.42",
    "@types/node": "22.20.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "nitro": "3.0.260603-beta",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vite-tsconfig-paths": "6.1.1"
  }
}
