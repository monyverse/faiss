{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FAISS chart values",
  "type": "object",
  "definitions": {
    "cidr": {
      "type": "string",
      "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/[0-9]{1,2}$"
    },
    "egressTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cidrs", "ports"],
      "properties": {
        "cidrs": { "type": "array", "items": { "$ref": "#/definitions/cidr" } },
        "except": { "type": "array", "items": { "$ref": "#/definitions/cidr" } },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1, "maximum": 65535 }
        }
      }
    },
    "remoteSecret": {
      "type": "object",
      "required": ["remoteKey"],
      "properties": {
        "remoteKey": { "type": "string" }
      }
    },
    "scaledWorkload": {
      "type": "object",
      "required": ["replicaCount", "resources", "autoscaling", "pdb"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 1 },
        "resources": { "type": "object" },
        "autoscaling": {
          "type": "object",
          "required": ["enabled", "minReplicas", "maxReplicas", "targetCPUUtilizationPercentage"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minReplicas": { "type": "integer", "minimum": 1 },
            "maxReplicas": { "type": "integer", "minimum": 1 },
            "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 1, "maximum": 100 }
          }
        },
        "pdb": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "maxUnavailable": { "type": ["integer", "string"] }
          }
        }
      }
    },
    "job": {
      "type": "object",
      "required": ["enabled", "backoffLimit", "activeDeadlineSeconds"],
      "properties": {
        "enabled": { "type": "boolean" },
        "backoffLimit": { "type": "integer", "minimum": 0 },
        "activeDeadlineSeconds": { "type": "integer", "minimum": 1 }
      }
    }
  },
  "required": ["env", "image", "aws", "config", "database", "externalSecrets", "api", "worker", "web", "migrate", "ingest", "ingress", "networkPolicy"],
  "properties": {
    "env": {
      "description": "FAISS_ENV",
      "enum": ["dev", "staging", "prod"]
    },
    "image": {
      "type": "object",
      "required": ["registry", "backendRepository", "webRepository", "tag"],
      "properties": {
        "registry": { "type": "string" },
        "backendRepository": { "type": "string", "minLength": 1 },
        "webRepository": { "type": "string", "minLength": 1 },
        "tag": {
          "description": "Immutable image tag. Must be a quoted string; \"latest\" is rejected. Empty only in the base values file.",
          "type": "string",
          "pattern": "^$|^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$",
          "not": { "enum": ["latest"] }
        },
        "pullPolicy": { "enum": ["IfNotPresent", "Always", "Never"] }
      }
    },
    "publicHost": { "type": "string" },
    "aws": {
      "type": "object",
      "required": ["region"],
      "properties": {
        "region": { "type": "string", "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]$" }
      }
    },
    "config": {
      "type": "object",
      "required": ["litellm", "models", "retriever", "opensearch", "authMode", "oidc", "temporal"],
      "properties": {
        "litellm": {
          "type": "object",
          "required": ["baseUrl"],
          "properties": { "baseUrl": { "type": "string" } }
        },
        "models": {
          "type": "object",
          "required": ["reasoning", "fast", "embedding"],
          "properties": {
            "reasoning": { "type": "string" },
            "fast": { "type": "string" },
            "embedding": { "type": "string" }
          }
        },
        "retriever": { "type": "string", "minLength": 1 },
        "opensearch": {
          "type": "object",
          "required": ["url", "index", "auth", "service"],
          "properties": {
            "url": { "type": "string" },
            "index": { "type": "string" },
            "auth": { "enum": ["sigv4", "basic", "none"] },
            "service": { "enum": ["es", "aoss"] }
          }
        },
        "authMode": {
          "description": "The backend only starts in Kubernetes with oidc.",
          "enum": ["oidc"]
        },
        "oidc": {
          "type": "object",
          "required": ["issuer", "audience", "jwksUrl"],
          "properties": {
            "issuer": { "type": "string" },
            "audience": { "type": "string" },
            "jwksUrl": { "type": "string" },
            "rolesClaim": { "type": "string" },
            "countriesClaim": { "type": "string" }
          }
        },
        "temporal": {
          "type": "object",
          "required": ["address"],
          "properties": {
            "address": { "type": "string" },
            "namespace": { "type": "string" },
            "taskQueue": { "type": "string" }
          }
        },
        "documentsBucket": { "type": "string" },
        "otlpEndpoint": { "type": "string" },
        "extra": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "database": {
      "type": "object",
      "required": ["scheme", "host", "port", "name"],
      "properties": {
        "scheme": { "type": "string", "minLength": 1 },
        "host": { "type": "string" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "name": { "type": "string", "minLength": 1 },
        "urlParams": { "type": "string" }
      }
    },
    "externalSecrets": {
      "type": "object",
      "required": ["enabled", "secretStore", "refreshInterval", "litellm", "database", "migrateDatabase", "opensearch"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "migrateExistingSecret": { "type": "string" },
        "secretStore": {
          "type": "object",
          "required": ["kind", "name"],
          "properties": {
            "kind": { "enum": ["ClusterSecretStore", "SecretStore"] },
            "name": { "type": "string", "minLength": 1 }
          }
        },
        "refreshInterval": { "type": "string", "minLength": 1 },
        "litellm": { "$ref": "#/definitions/remoteSecret" },
        "database": { "$ref": "#/definitions/remoteSecret" },
        "migrateDatabase": { "$ref": "#/definitions/remoteSecret" },
        "opensearch": { "$ref": "#/definitions/remoteSecret" }
      }
    },
    "podSecurityContext": { "type": "object" },
    "containerSecurityContext": { "type": "object" },
    "api": { "$ref": "#/definitions/scaledWorkload" },
    "web": {
      "allOf": [
        { "$ref": "#/definitions/scaledWorkload" },
        {
          "type": "object",
          "required": ["oidc"],
          "properties": {
            "oidc": {
              "type": "object",
              "required": ["authority", "clientId", "scope"],
              "properties": {
                "authority": { "type": "string" },
                "clientId": { "type": "string" },
                "scope": { "type": "string" }
              }
            }
          }
        }
      ]
    },
    "worker": {
      "type": "object",
      "required": ["replicaCount", "strategy", "metricsPort", "resources"],
      "properties": {
        "replicaCount": { "type": "integer", "minimum": 0 },
        "strategy": {
          "type": "object",
          "required": ["type"],
          "properties": { "type": { "enum": ["Recreate", "RollingUpdate"] } }
        },
        "metricsPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "resources": { "type": "object" }
      }
    },
    "migrate": { "$ref": "#/definitions/job" },
    "ingest": { "$ref": "#/definitions/job" },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "scheme", "sslPolicy", "inboundCidrs"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string", "minLength": 1 },
        "scheme": { "enum": ["internal", "internet-facing"] },
        "certificateArn": { "type": "string", "pattern": "^$|^arn:aws[a-z-]*:acm:" },
        "sslPolicy": { "type": "string", "minLength": 1 },
        "inboundCidrs": { "type": "array", "items": { "$ref": "#/definitions/cidr" } },
        "loadBalancerAttributes": { "type": "array", "items": { "type": "string" } },
        "annotations": { "type": "object" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressCidrs", "egress"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressCidrs": { "type": "array", "items": { "$ref": "#/definitions/cidr" } },
        "monitoringNamespace": { "type": "string" },
        "podIdentityAgent": { "type": "boolean" },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["database", "opensearch", "litellm", "temporal", "oidc", "awsEndpoints", "otel"],
          "properties": {
            "database": { "$ref": "#/definitions/egressTarget" },
            "opensearch": { "$ref": "#/definitions/egressTarget" },
            "litellm": { "$ref": "#/definitions/egressTarget" },
            "temporal": { "$ref": "#/definitions/egressTarget" },
            "oidc": { "$ref": "#/definitions/egressTarget" },
            "awsEndpoints": { "$ref": "#/definitions/egressTarget" },
            "otel": { "$ref": "#/definitions/egressTarget" }
          }
        },
        "extraBackendEgress": { "type": "array", "items": { "type": "object" } }
      }
    },
    "serviceMonitor": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "interval": { "type": "string" },
        "labels": { "type": "object" }
      }
    }
  }
}
