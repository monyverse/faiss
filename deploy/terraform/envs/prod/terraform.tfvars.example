# Copy to terraform.tfvars (git-ignored). Every REPLACE_ME / 000000000000 value is
# a placeholder. No secret values belong in this file.

region              = "af-south-1"
allowed_account_ids = ["000000000000"]

app_environments = {
  prod = {
    db_min_capacity   = 1
    db_max_capacity   = 8
    db_instance_count = 2
  }
}

vpc_cidr = "10.50.0.0/16"

# Networks (VPN / CI runners) that may reach the private Kubernetes API.
cluster_endpoint_private_access_cidrs = ["10.0.0.0/8"]

# Existing OpenSearch RAG engine, owned by the search team.
opensearch_endpoint = "https://REPLACE_ME.af-south-1.es.amazonaws.com"
opensearch_arn      = "arn:aws:es:af-south-1:000000000000:domain/REPLACE_ME"
opensearch_service  = "es"
opensearch_auth     = "sigv4"

# Audit archive immutability. Both values are decisions for records management
# and compliance, not engineering defaults. GOVERNANCE can be lifted by a
# privileged principal; COMPLIANCE cannot be shortened or removed by anyone.
audit_object_lock_mode = "GOVERNANCE"
audit_retention_days   = 0 # REPLACE_ME: must be >= 1

# Images are pulled from the registry owned by the non-production stack.
create_ecr_repositories = false

gitops_repo_url  = "https://github.com/REPLACE_ME/faiss.git"
gitops_apps_path = "deploy/argocd/clusters/prod"
argocd_hostname  = "argocd.prod.REPLACE_ME.example"
