# Copy to .env for local development. Every value has a safe local default; nothing here is a secret.

FAISS_ENV=dev
FAISS_AUTH_MODE=dev                 # dev = pick a built-in persona with the X-Faiss-User header. Clusters use oidc.

# Absa LiteLLM gateway. Leave empty to run offline (answers are built from retrieved passages, no model).
FAISS_LITELLM_BASE_URL=
FAISS_LITELLM_API_KEY=
FAISS_MODEL_REASONING=faiss-reasoning   # gateway model aliases
FAISS_MODEL_FAST=faiss-fast
FAISS_MODEL_EMBEDDING=faiss-embedding

# Retrieval. local = corpus shipped with the code. opensearch = the bank's RAG engine.
FAISS_RETRIEVER=local
FAISS_OPENSEARCH_URL=
FAISS_OPENSEARCH_INDEX=faiss-knowledge
FAISS_OPENSEARCH_AUTH=none          # sigv4 | basic | none
FAISS_OPENSEARCH_SERVICE=es         # es | aoss

# Goal scheduling. Empty = built-in database-backed scheduler.
FAISS_TEMPORAL_ADDRESS=
